# Supabase project credentials
# Find these in your Supabase project → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# App base URL (used for QR code generation)
VITE_APP_URL=http://localhost:5173

# Stripe (for card payments – use Stripe hosted checkout)
# Leave blank to enable cash-only mode
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Sentry error monitoring (optional but recommended for production)
# Create a project at https://sentry.io → Settings → Projects → Client Keys (DSN)
# Leave blank in development to disable Sentry entirely
VITE_SENTRY_DSN=

# App version (optional — shown in Sentry releases for source map attribution)
VITE_APP_VERSION=0.1.0
